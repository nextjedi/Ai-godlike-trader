# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Server Configuration
SERVER_PORT=8080

# Database Configuration
DATABASE_URL=jdbc:h2:file:~/trading_db
DATABASE_USERNAME=admin
DATABASE_PASSWORD=change_this_password
DATABASE_DRIVER=org.h2.Driver

# For MySQL (uncomment and configure if using MySQL)
# DATABASE_URL=jdbc:mysql://localhost:3306/trading_db
# DATABASE_DRIVER=com.mysql.cj.jdbc.Driver

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=60000

# Kafka Configuration (Optional)
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=trading-consumers
TICK_KAFKA_TOPIC=trading-ticks

# Email Configuration (for reports)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# Zerodha Configuration
ZERODHA_ENABLED=true
ZERODHA_USER_ID=YOUR_USER_ID
ZERODHA_API_KEY=YOUR_API_KEY
ZERODHA_API_SECRET=YOUR_API_SECRET
ZERODHA_TOTP_KEY=YOUR_TOTP_KEY
ZERODHA_PASSWORD=YOUR_PASSWORD

# Upstox Configuration (Future)
UPSTOX_ENABLED=false
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Portfolio Configuration
PORTFOLIO_CAPITAL=1000000
MAX_POSITION_SIZE=15000
MAX_DRAWDOWN_PERCENT=10
MAX_EXPOSURE_PERCENT=80

# Tick Data Configuration
TICK_DATA_ENABLED=true
TICK_DATA_PROVIDER=redis
TICK_STREAM_KEY=trading:ticks
TICK_CONSUMER_GROUP=tick-processors

# Reporting Configuration
REPORTING_ENABLED=true
REPORT_DIR=./reports
REPORT_EMAIL_ENABLED=false
REPORT_EMAIL_FROM=trading@example.com
REPORT_EMAIL_TO=admin@example.com

# Report Schedules (Cron expressions)
REPORT_SCHEDULE_DAILY=0 30 15 * * MON-FRI
REPORT_SCHEDULE_WEEKLY=0 0 10 * * SAT
REPORT_SCHEDULE_MONTHLY=0 0 10 1 * *

# Trading Schedule
MARKET_START_TIME=0 45 8 * * MON-FRI
MARKET_END_TIME=0 16 16 * * MON-FRI

# Strategy Configuration
STRATEGY_TIP_BASED_ENABLED=true
STRATEGY_TIP_BASED_MAX_POSITION=15000
STRATEGY_TIP_BASED_ENTRY_THRESHOLD=5
STRATEGY_TIP_BASED_STOP_LOSS=15
STRATEGY_TIP_BASED_TRAILING_STOP=4

# Logging
LOG_LEVEL=DEBUG
LOG_FILE_PATH=logs

# Monitoring
PROMETHEUS_ENABLED=false
